# Copy this file to .env (or set these as environment variables / IntelliJ run config vars)
# Never commit the real .env file or real secret values.

# Required: get a free key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Required: any long random string, e.g. generate with `openssl rand -hex 32`
JWT_SECRET=

# Optional: defaults to admin / (must be set) if left blank
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: defaults to postgres / postgres for local development
DB_USERNAME=postgres
DB_PASSWORD=postgres
